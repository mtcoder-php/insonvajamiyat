APP_NAME="Inson va Jamiyat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=insonvajamiyat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pochta (email tasdiqlash, parolni tiklash xatlari)
# Lokal: Mailpit (SMTP 1025, xatlar http://localhost:8025 da ko'rinadi)
# Server: haqiqiy SMTP (masalan, Gmail: smtp.gmail.com, 587, MAIL_SCHEME=null, "App password")
# MAIL_MAILER=log bo'lsa xatlar yuborilmaydi — storage/logs/laravel.log ga yoziladi
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@insonvajamiyat.uz"
MAIL_FROM_NAME="Inson va Jamiyat"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jurnal rekvizitlari (config/journal.php) — bo'sh qolganlari saytda ko'rsatilmaydi
JOURNAL_ISSN=
JOURNAL_EISSN=
JOURNAL_DOI_PREFIX=
JOURNAL_FREQUENCY="Yiliga 4 marta (kvartal)"
JOURNAL_DEFAULT_ISSUE_COVER=coverimg/cover.png
JOURNAL_EMAIL=info@insonvajamiyat.uz
JOURNAL_PHONE="+998 71 234 56 78"
JOURNAL_ADDRESS="Toshkent, O'zbekiston"
JOURNAL_PLAGIARISM_MAX=20
JOURNAL_PAYMENT_RECIPIENT=
JOURNAL_PAYMENT_BANK=
JOURNAL_PAYMENT_ACCOUNT=
JOURNAL_PAYMENT_MFO=
JOURNAL_PAYMENT_INN=
JOURNAL_TELEGRAM_URL=
JOURNAL_FACEBOOK_URL=
JOURNAL_INSTAGRAM_URL=
JOURNAL_YOUTUBE_URL=
JOURNAL_LINKEDIN_URL=

# To'lov tizimlari
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=

# AI xizmatlari (Anthropic Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
