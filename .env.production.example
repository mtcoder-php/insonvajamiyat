# ============================================================================
# PRODUCTION namunasi. Serverda:  cp .env.production.example .env
#                                 php artisan key:generate
# So'ng DB_*, MAIL_*, to'lov va AI kalitlarini to'ldiring.
# .env faylini HECH QACHON git'ga qo'shmang (u .gitignore'da).
# Pochta va jurnal rekvizitlarini admin panel → Tizim sozlamalari'dan ham o'zgartirish mumkin.
# ============================================================================

APP_NAME="Inson va Jamiyat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://insonvajamiyat.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=insonvajamiyat
DB_USERNAME=insonvajamiyat
# Alohida foydalanuvchi va kuchli parol (root EMAS)
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Eng uzun job (zaxira) 3600 s — retry_after undan katta bo'lishi shart
DB_QUEUE_RETRY_AFTER=3700

CACHE_STORE=database
CACHE_PREFIX=ivj_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pochta (email tasdiqlash, parolni tiklash xatlari)
# Lokal: Mailpit (SMTP 1025, xatlar http://localhost:8025 da ko'rinadi)
# Server: haqiqiy SMTP (masalan, Gmail: smtp.gmail.com, 587, MAIL_SCHEME=null, "App password")
# MAIL_MAILER=log bo'lsa xatlar yuborilmaydi — storage/logs/laravel.log ga yoziladi
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@insonvajamiyat.uz
# Pochta "App password" — hech kimga ko'rsatmang, git'ga qo'shmang
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@insonvajamiyat.uz"
MAIL_FROM_NAME="Inson va Jamiyat"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Jurnal rekvizitlari (config/journal.php) — bo'sh qolganlari saytda ko'rsatilmaydi
JOURNAL_ISSN=
JOURNAL_EISSN=
JOURNAL_DOI_PREFIX=
JOURNAL_FREQUENCY="Yiliga 4 marta (kvartal)"
JOURNAL_DEFAULT_ISSUE_COVER=coverimg/cover.png
JOURNAL_EMAIL=info@insonvajamiyat.uz
JOURNAL_PHONE="+998 71 234 56 78"
JOURNAL_ADDRESS="Toshkent, O'zbekiston"
JOURNAL_PLAGIARISM_MAX=20
JOURNAL_PAYMENT_RECIPIENT=
JOURNAL_PAYMENT_BANK=
JOURNAL_PAYMENT_ACCOUNT=
JOURNAL_PAYMENT_MFO=
JOURNAL_PAYMENT_INN=
JOURNAL_TELEGRAM_URL=
JOURNAL_FACEBOOK_URL=
JOURNAL_INSTAGRAM_URL=
JOURNAL_YOUTUBE_URL=
JOURNAL_LINKEDIN_URL=

# Google / ORCID orqali kirish (config/services.php). ID bo'sh bo'lsa — tugma ko'rinmaydi
# Google Cloud Console → OAuth client (Web): Authorized redirect URI = {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ORCID → Developer Tools (Public API): Redirect URI = {APP_URL}/auth/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_SANDBOX=false

# To'lov tizimlari (config/payments.php)
# Click: Prepare URL = {APP_URL}/payments/click/prepare, Complete URL = {APP_URL}/payments/click/complete
CLICK_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Payme: Endpoint URL = {APP_URL}/payments/payme, hisob maydoni = payment_id
PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=false
PAYME_IKPU=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=0

# AI Studio (config/ai.php). Kalit va modelni admin panel → AI Studio → Sozlamalar'da ham kiritish mumkin
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_ENABLED=true
AI_AUTHOR_MONTHLY_TOKENS=50000
AI_STAFF_MONTHLY_TOKENS=200000
AI_MAX_INPUT_CHARS=30000
